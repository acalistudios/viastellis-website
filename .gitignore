# dependencies
node_modules

# build output
dist
dist-ssr

# env / secrets — provided via GitHub Actions secrets, never committed
.env
.env.local
.env.*.local

# editor/OS
*.tmp.*
.DS_Store
.vscode

# Internal handoff doc — never publish
ANDROID_HANDOFF.md

# Local dev config (launch.json etc.)
.claude/


# Local-only Capacitor overrides — machine-specific native project path
capacitor.local.json

# The native Android project lives in AndroidStudioProjects, never in this repo.
# Belt-and-braces: if it is ever recreated here by mistake, do not commit it.
# NOTE: a leading / anchors to the repo root only (PRACTICES.md §4). Kept as-is
# for android since that is where the damage happened; the iOS rules below are
# deliberately unanchored so they match at any depth.
/android/

# The native iOS project lives at ~/Developer/viastellis-ios, never in this repo.
# Same reasoning as android above, plus Xcode's own build artefacts: Pods/ alone
# is tens of MB, and DerivedData is far larger. capacitor.config.ts throws rather
# than defaulting to ./ios, but that guard protects only the CLI path — these
# rules are the backstop if a project is ever created here by hand.
ios/
Pods/
*.xcworkspace
*.xcuserstate
xcuserdata/
DerivedData/

# Vite's cache. vite.config.ts puts this in %LOCALAPPDATA% on Windows, but that
# variable does not exist on macOS, so it falls back to __dirname — i.e. INSIDE
# this public repo. Observed on Hanss-MacBook-Pro 2026-09-23 during the iOS work.
vite-cache/

# --- Secrets & signing (ACALI PRACTICES.md §4) -------------------------------
# Redundant on purpose: overlapping rules cost nothing and catch each other's gaps.
# NOTE: ACALI signing keys carry NO file extension, so *.jks/*.keystore will not
# match them. Keep signing keys OUTSIDE every repo; these are a backstop only.
.env
.env.*
!.env.example
*.bak
*.bak-*
*.jks
*.keystore
*.local.json
